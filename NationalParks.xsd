<?xml version="1.0" encoding="utf-8"?>
<xsd:schema 
	xmlns:xsd="http://www.w3.org/2001/XMLSchema" 
	xmlns="https://github.com/RyanMSinclaire/CSE-445-Assignment4/blob/main/NationalParks.xsd" 
	targetNamespace="https://github.com/RyanMSinclaire/CSE-445-Assignment4/blob/main/NationalParks.xsd"
	elementFormDefault="qualified"
	attributeFormDefault="unqualified">
	<!-- Root -->
	<xsd:element name="NationalParks" type="NPS"/>
	
	<!--National Parks-->
	<xsd:complexType name="NPS">
		<xsd:sequence>
			<xsd:element name="NationalPark" type="NationalParkDetails" minOccurs="1" maxOccurs="unbounded"/>
		</xsd:sequence>
	</xsd:complexType>
	
	<!-- Park Instance-->
	<xsd:complexType name="NationalParkDetails">
		<xsd:sequence>
			<xsd:element name="Name" type="xsd:string" minOccurs="1" maxOccurs="1"/>
			<xsd:element name="Phone" type="xsd:string" minOccurs="1" maxOccurs="unbounded"/>
			<xsd:element name="Address" type="Address" minOccurs="1" maxOccurs="1"/>
		</xsd:sequence>

		<xsd:attribute name ="Rating" type="xsd:string" use="optional"/>
	</xsd:complexType>
	
	<!-- Address -->
	<xsd:complexType name="Address">
		<xsd:sequence>
			<xsd:element name="Number" type="xsd:string"/>
			<xsd:element name="Street" type="xsd:string"/>
			<xsd:element name="City" type="xsd:string"/>
			<xsd:element name="State" type="xsd:string"/>
			<xsd:element name="Zip" type="xsd:string"/>
		</xsd:sequence>

		<xsd:attribute name="NearestAirport" type="xsd:string" use="required"/>
	</xsd:complexType>
</xsd:schema>
